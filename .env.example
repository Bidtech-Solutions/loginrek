# =============================================================================
# loginrek — SATU file env untuk semua produk (backend, dashboard, mobile, compose)
#
#   cp .env.example .env
#
# .env di root ini dibaca oleh:
#   - docker-compose.yml / docker-compose.prod.yml  (otomatis)
#   - loginrek-backend   (godotenv, ../.env)
#   - loginrek-dashboard (Vite envDir; hanya VITE_* yang masuk ke bundle)
#   - loginrek-mobile    (npm run dev; hanya EXPO_PUBLIC_* yang masuk ke bundle)
#
# DEV LOKAL : ganti semua CHANGE_ME dengan nilai apa saja (mis. "dev").
# PRODUCTION: file ini dikirim ke VPS oleh GitHub Actions -> cp ke .env lalu isi
#             CHANGE_ME dengan secret sungguhan (openssl rand -hex 32). .env di VPS
#             tidak pernah ditimpa deploy (kecuali IMAGE_TAG & GHCR_OWNER).
#
# JANGAN taruh secret pada variabel berprefix VITE_ / EXPO_PUBLIC_ (masuk bundle).
# =============================================================================

# ---- Umum -------------------------------------------------------------------
TZ=Asia/Jakarta

# ---- Backend (loginrek-backend) --------------------------------------------
PORT=3333
APP_ENV=development
# Wajib, minimal 32 karakter (server menolak start bila kosong/CHANGE_ME):  openssl rand -hex 32
JWT_SECRET=CHANGE_ME
# Origin browser yang boleh memanggil API (dashboard), pisahkan dengan koma. Mobile tidak butuh CORS.
CORS_ORIGINS=http://localhost:5173

# ---- Akun awal (seeder) ---------------------------------------------------------
# Hanya dibuat SEKALI saat tabel users masih kosong; password di-hash bcrypt.
# Admin/HR (is_admin=true): boleh login ke dashboard DAN mobile. Wajib di production.
SEED_ADMIN_EMAIL=hr@loginrek.com
SEED_ADMIN_PASSWORD=CHANGE_ME
# Karyawan uji (is_admin=false): hanya bisa login di mobile. Tidak dibuat di production.
SEED_EMPLOYEE_EMAIL=karyawan@loginrek.com
SEED_EMPLOYEE_PASSWORD=CHANGE_ME

# ---- PostgreSQL ---------------------------------------------------------------
# Backend otomatis fallback ke SQLite (SQLITE_PATH) bila PostgreSQL belum menyala.
# Di production compose meng-override RUSTFS_ENDPOINT=lr-rustfs:9000.
# RUSTFS_PUBLIC_URL dibiarkan kosong: RustFS tidak diekspos ke publik; foto disajikan
# backend lewat GET /uploads/* (production memaksa kosong di compose).
RUSTFS_ENDPOINT=127.0.0.1:9000
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME
RUSTFS_BUCKET=loginrek-media
RUSTFS_USE_SSL=false
RUSTFS_PUBLIC_URL=

# ---- Kompresi gambar (backend) ------------------------------------------------
IMAGE_MAX_WIDTH=1280
IMAGE_MAX_HEIGHT=720
IMAGE_WEBP_QUALITY=80

# ---- Port host untuk docker compose DEV (bind 127.0.0.1) ---------------------
# Production tidak memublikasikan port aplikasi (Traefik); hanya konsol RustFS.
POSTGRES_HOST_PORT=5432
RUSTFS_API_HOST_PORT=9000
RUSTFS_CONSOLE_HOST_PORT=9001

# ---- Production (VPS + Traefik) — dipakai docker-compose.prod.yml --------------
# Domain publik; DNS-nya harus mengarah ke VPS (Traefik menerbitkan sertifikat Let's Encrypt).
DASHBOARD_DOMAIN=loginrek.bidtech.co.id
API_DOMAIN=loginrek-api.bidtech.co.id

# ---- Dashboard (loginrek-dashboard) -----------------------------------------
# Origin backend untuk dev. Di production CI mengisinya (build arg) dengan
# https://loginrek-api.bidtech.co.id — lihat env API_URL di .github/workflows/loginrek.yml.
VITE_API_URL=http://localhost:3333

# ---- Mobile (loginrek-mobile) -----------------------------------------------
# Kosongkan EXPO_PUBLIC_API_URL untuk deteksi otomatis: app memakai IP laptop yang
# menjalankan `npm run dev` + EXPO_PUBLIC_API_PORT. Isi bila pakai tunnel/server lain, mis.
#   EXPO_PUBLIC_API_URL=https://xxxx.trycloudflare.com/api/v1
# Build EAS memakai nilai di loginrek-mobile/eas.json, bukan file ini.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=3333

# ---- Deploy (diisi/diperbarui otomatis oleh workflow) ------------------------
# Owner GitHub dalam huruf kecil (user/organisasi pemilik repo)
GHCR_OWNER=change-me
IMAGE_TAG=latest
