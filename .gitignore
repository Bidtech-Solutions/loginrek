# =============================================================================
# loginrek — Comprehensive Root .gitignore
# =============================================================================

# --- Secrets & Environment Variables ---
.env
.env.*
.env.local
.env*.local
*.local
!.env.example

# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build Outputs ---
dist/
build/
dist-ssr/
out/
web-build/
*.tsbuildinfo

# --- Go Binaries & Cache ---
*.exe
*.exe~
*.dll
/loginrek-backend/api
*.so
*.dylib
.gocache/
.gopath/
bin/

# --- Databases & Runtime Data ---
*.sqlite
*.sqlite3
*.db
/data/
/tmp/
tmp/

# --- Runtime Uploads (Backend dev testing) ---
**/public/uploads/attendances/*
!**/public/uploads/attendances/.gitkeep
**/public/uploads/avatars/*
!**/public/uploads/avatars/.gitkeep
!**/public/uploads/avatars/default_avatar.png

# --- Mobile & Native Builds (Expo / React Native) ---
.expo/
*.apk
*.aab
loginrek-mobile/ios/
loginrek-mobile/android/
loginrek-mobile/expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
*.pem

# --- Temporary & Backup Files ---
*.tmp
*.temp
*~
*.bak
*.swp
*.swo
_backup_*
*.tar.gz
*.zip

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- OS & Editor Files ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Agent / AI Settings ---
.claude/settings.local.json
