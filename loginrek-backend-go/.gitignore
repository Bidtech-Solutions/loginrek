# =============================================================================
# loginrek-backend-go — .gitignore
# =============================================================================

# Binaries & Executables
*.exe
*.exe~
*.dll
*.so
*.dylib
api
api.exe

# Go build cache & local gopath
.gocache/
.gopath/

# Local databases & Temp files
tmp/
*.sqlite
*.sqlite3
*.db
*.tmp
*.temp
*~
*.bak

# Environment variables
.env
.env.*
!.env.example

# Runtime Uploads (Ignore uploaded selfies & avatars, keep default assets)
public/uploads/attendances/*
!public/uploads/attendances/.gitkeep
public/uploads/avatars/*
!public/uploads/avatars/.gitkeep
!public/uploads/avatars/default_avatar.png

# Logs
*.log

