# ============================================================
# LOGIN REK - CONFIGURATION (GO + GIN + POSTGRESQL + RUSTFS)
# ============================================================

# Server Configuration
PORT=3333
APP_ENV=development

# Database Configuration (PostgreSQL)
# Catatan: Jika PostgreSQL belum menyala, server secara cerdas 
# melakukan auto-fallback ke SQLite lokal (tmp/db.sqlite3) tanpa error!
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=loginrek_db
DB_SSLMODE=disable
SQLITE_PATH=tmp/db.sqlite3

# JWT Secret Key
JWT_SECRET=loginrek-super-secret-jwt-key-2026

# RustFS / S3 Compatible Object Storage
# Catatan: Jika RustFS belum dinyalakan, backend secara otomatis
# menyimpan gambar ke disk lokal (public/uploads/) sebagai fallback aman.
RUSTFS_ENDPOINT=127.0.0.1:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin123
RUSTFS_BUCKET=loginrek-media
RUSTFS_USE_SSL=false
RUSTFS_PUBLIC_URL=

# Otomatis Kompresi Gambar
IMAGE_MAX_WIDTH=1280
IMAGE_MAX_HEIGHT=720
IMAGE_WEBP_QUALITY=80

