    "@tanstack/react-query": "^5.107.1",
    "dayjs": "^1.11.23",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-background-task": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-doctor": "^1.21.6",
    "expo-font": "~58.0.10",
