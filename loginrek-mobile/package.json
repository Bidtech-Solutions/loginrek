{
  "name": "loginrek-mobile",
  "version": "1.0.1",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env node_modules/expo/bin/cli start",
    "dev": "node --env-file-if-exists=../.env node_modules/expo/bin/cli start",
    "web": "node --env-file-if-exists=../.env node_modules/expo/bin/cli start --web --lan",
    "dev:tunnel": "node --env-file-if-exists=../.env node_modules/expo/bin/cli start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "doctor": "expo-doctor"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^7.0.5",
    "@react-native-community/netinfo": "12.0.1",
