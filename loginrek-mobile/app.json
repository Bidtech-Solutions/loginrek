{
  "expo": {
    "name": "SapaKerja",
    "slug": "loginrek",
    "scheme": "loginrek",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "id.co.bidtech.loginrek",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "SapaKerja membutuhkan akses kamera untuk foto selfie absensi.",
        "NSLocationWhenInUseUsageDescription": "SapaKerja membutuhkan akses lokasi untuk memastikan Anda berada di area kantor.",
        "NSPhotoLibraryUsageDescription": "SapaKerja membutuhkan izin akses galeri foto untuk mengubah foto profil akun Anda.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "id.co.bidtech.loginrek",
      "config": {
          "googleMaps": { "apiKey": "AIzaSyBIPE5ig24GNm1qoVCvrAXl2WHqKy5U5kA" }
        },      
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0B7F78",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B7F78"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-localization",
      "expo-background-task",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "sapakerja",
          "organization": "pt-solusi-bisnis-jalanin-aja-d"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B7F78",
          "defaultChannel": "default",
          "sounds": [
            "./assets/notifications/sapakerja-notification.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "da2c26bc-bc7b-447e-a50e-160af56919a7"
      }
    },
    "owner": "bidtech-solutions",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://api.sapakerja.com/updates/manifest",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    }
  }
}
